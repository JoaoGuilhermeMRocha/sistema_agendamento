# Copie para .env e preencha. O .env nunca vai para o Git.

# Gere uma chave com: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 1 só no computador. Na VPS fica vazio.
DJANGO_DEBUG=1
# Endereços aceitos, separados por vírgula.
DJANGO_HOSTS=127.0.0.1,localhost

# No computador, o Postgres do container. Na VPS, o deploy/novo_cliente.sh escreve o .env
# com POSTGRES_HOST=/var/run/postgresql e sem senha (o Postgres confere o usuário do sistema).
POSTGRES_DB=santiago
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Pasta das fotos enviadas pelo painel (padrão: midia/, dentro do projeto).
# DJANGO_MIDIA=
