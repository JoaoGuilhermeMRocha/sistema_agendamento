# Django + Gunicorn de uma barbearia. %i = slug (ex.: agenda@santiago).
[Unit]
Description=Agendamento %i (Django + Gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=%i
Group=%i
WorkingDirectory=/srv/clientes/%i/codigo
RuntimeDirectory=agenda-%i
RuntimeDirectoryMode=0750
# umask 007: o socket e as fotos ficam legíveis para o grupo da barbearia, do qual o Caddy faz parte.
ExecStart=/srv/clientes/%i/codigo/.venv/bin/gunicorn arsystems.wsgi \
  --workers 2 --bind unix:/run/agenda-%i/gunicorn.sock --umask 007 \
  --forwarded-allow-ips=* --access-logfile -
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
